DeleteCollaboratorScreen {
    align: center middle;
}

.collaborator-main-container {
    layout: grid;
    grid-size: 2;
    grid-columns: 2fr 1fr;
    grid-rows: 2fr 2fr 5;
    grid-gutter: 1;
    overflow: auto auto;
    border: round $primary;
}

#collaborators-table {
    border: round $secondary;
    row-span: 2;
    height: 100%;
}

#collaborator-customers-table {
    border: round $secondary;
    height: 100%;
}

#collaborator-events-table {
    border: round $secondary;
    height: 100%;
}

.collaborator-buttons-container {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    align: center middle;
    border: round $secondary;
    height: 5;
}

.customers-events-buttons-container {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    align: center middle;
    border: round $secondary;
    height: 5;
}