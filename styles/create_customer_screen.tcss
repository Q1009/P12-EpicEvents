.create-customer-main-container {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    grid-rows: auto 5;
    border: round $primary;
    overflow: auto auto;
    content-align: center middle;
}

.customer-data-input-container {
    overflow: auto auto;
    border: round $secondary;
    height: auto;
}

.customer-contact-input-container {
    overflow: auto auto;
    border: round $secondary;
    height: auto;
    align: center middle;
}

#customer-contact-input-choice {
    layout: horizontal;
    align: center middle;
    height: auto;
    border: round $panel;
}

.customer-contact-form-input-container {
    align: center top;
    border: round $boost;
    height: auto;
}

.customer-contact-select-input-container {
    align: center top;
    border: round $boost;
    height: auto;
}

.customer-contact-radio-button {
    width: auto;
    height: auto;
}

.create-customer-buttons-container {
    column-span: 2;
    layout: horizontal;
    align: center top;
    height: auto;
    width: 100%;
}

.create-customer-button {
    width: auto;
    height: auto;
    margin: 0 2;
}